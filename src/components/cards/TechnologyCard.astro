---
import type { CollectionEntry } from 'astro:content'

import { slugify } from '~utils/slugs'

type Props = {
  data: CollectionEntry<'technologies'>
}

const { data } = Astro.props
---

<article class="flex flex-col items-center gap-4 bg-gray-800 p-4">
  <div class="flex aspect-square h-16 items-center justify-center">
    <img
      class="max-h-full max-w-full"
      src={`/technology/${slugify(data.id)}.svg`}
      alt={data.data.name}
    />
  </div>
  <div class="font-bold">{data.data.name}</div>
</article>
