---
import type { CollectionEntry } from 'astro:content'

import EmojiIcon from '~components/general/EmojiIcon.vue'

type Props = {
  data: CollectionEntry<'papers'>
}

const { data } = Astro.props
---

<article class="flex flex-col">
  <div class="bg-gray-800 p-4 font-bold">{data.data.title}</div>
  <div class="flex grow flex-col justify-between gap-4 bg-gray-700 p-4">
    <div>{data.data.abstract}</div>
    <div class="flex items-center justify-between">
      <div class="aspect-square h-8">
        <EmojiIcon emoji={data.data.icon} />
      </div>
      <a
        class="w-fit bg-gray-800 px-2 py-1 font-semibold hover:bg-gray-700"
        href={data.data.link ?? `/paper/${data.id}.pdf`}
        target="_blank"
      >
        {data.data.link ? 'Web' : 'PDF'}
      </a>
    </div>
  </div>
</article>
