---
import EmojiIcon from '~components/general/EmojiIcon.vue'

import { dateToString } from '~utils/dates'

type Props = {
  slug: string
  title: string
  icon: string
  date: Date
  abstract: string
}

const { slug, title, icon, date, abstract } = Astro.props
---

<a class="group max-w-md bg-gray-700" href={`/post/${slug}/`}>
  <div class="flex items-center gap-4 bg-gray-800 p-4 group-hover:bg-gray-700">
    <div class="aspect-square h-12" transition:name={`${slug}-icon`}>
      <EmojiIcon emoji={icon} />
    </div>
    <div class="flex flex-col gap-1">
      <div
        class="text-2xl leading-6 font-bold"
        transition:name={`${slug}-title`}
      >
        {title}
      </div>
      <div
        class="leading-5 font-semibold text-gray-400"
        transition:name={`${slug}-date`}
      >
        {dateToString(date)}
      </div>
    </div>
  </div>
  <div class="p-4">{abstract}</div>
</a>
