---
import IconHeader from './IconHeader.astro'
import SectionCollapser from './SectionCollapser.vue'

type Props = {
  title: string
}

const { title } = Astro.props
---

<div class="mt-12 mb-8 flex items-center justify-between [&_h2]:m-0">
  <IconHeader>{title}</IconHeader>
  <SectionCollapser client:visible id={title} />
</div>
<div id={title}>
  <slot />
</div>
