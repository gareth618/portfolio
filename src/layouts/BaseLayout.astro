---
import { ClientRouter } from 'astro:transitions'

import NavigationLink from '~components/general/NavigationLink.astro'

import '~styles/global.css'

type Props = {
  title: string
  tags?: string[]
  abstract?: string
}

const {
  title,
  tags = ['blog', 'programming', 'computer science'],
  abstract = 'The blog of Iulian Oleniuc, software engineer in Iași, Romania',
} = Astro.props
---

<html class="scroll-smooth" lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content="Iulian Oleniuc" />
    <meta name="keywords" content={tags.join(', ')} />
    <meta name="description" content={abstract} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={abstract} />
    <meta property="og:image" content="https://ioleniuc.ro/og.png" />
    <title>{title} — Iulian Oleniuc</title>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.38/dist/katex.min.css"
    />
    <ClientRouter />
  </head>
  <body
    class="bg-gray-950 text-gray-200 antialiased selection:bg-green-300 selection:text-gray-950 [&_*:focus-visible]:outline-2 [&_*:focus-visible]:outline-offset-2 [&_*:focus-visible]:outline-gray-500 [&_*:focus-visible]:outline-dashed"
  >
    <header class="sticky top-0 z-20 bg-gray-900 shadow-lg">
      <div
        class="mx-auto flex max-w-screen-2xl justify-between px-12 py-8 *:w-fit max-md:p-4"
      >
        <div class="text-2xl font-bold">Iulian Oleniuc</div>
        <nav class="flex gap-4 max-md:gap-2">
          <NavigationLink link="/" title="Home" icon="🛖" />
          <NavigationLink link="/portfolio/" title="Portfolio" icon="🏆" />
          <NavigationLink link="/blog/" title="Blog" icon="✍️" />
        </nav>
      </div>
    </header>
    <main class="bg-gray-950">
      <div class="mx-auto max-w-screen-2xl p-12 max-md:px-4">
        <slot />
      </div>
    </main>
    <footer class="flex justify-center bg-gray-900 py-8 shadow-lg max-md:py-4">
      <div class="text-lg font-bold text-gray-600">
        Copyright © {new Date().getFullYear()} — Iulian Oleniuc
      </div>
    </footer>
  </body>
</html>
