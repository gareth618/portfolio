---
import { getCollection } from 'astro:content'

import CardSection from '~components/general/CardSection.astro'
import PaperCard from '~components/cards/PaperCard.astro'
import ProjectCard from '~components/cards/ProjectCard.astro'
import TechnologyCard from '~components/cards/TechnologyCard.astro'

import BaseLayout from '~layouts/BaseLayout.astro'

const technologies = (await getCollection('technologies')).toSorted(
  (technology1, technology2) => technology1.data.order - technology2.data.order,
)
const projects = (await getCollection('projects')).toSorted(
  (project1, project2) => project1.data.order - project2.data.order,
)
const papers = (await getCollection('papers')).toSorted(
  (paper1, paper2) => paper1.data.order - paper2.data.order,
)
---

<BaseLayout title="Portfolio">
  <h1 class="mb-12 text-5xl font-bold">Portfolio</h1>
  <CardSection title="💻 Technologies I Know">
    <section
      class="my-8 grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5"
    >
      {technologies.map(technology => <TechnologyCard data={technology} />)}
    </section>
  </CardSection>
  <CardSection title="🚀 Projects I’ve Coded">
    <section
      class="my-8 grid gap-4 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5"
    >
      {projects.map(project => <ProjectCard data={project} />)}
    </section>
  </CardSection>
  <CardSection title="📖 Papers I’ve Written">
    <section
      class="my-8 grid gap-4 md:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4"
    >
      {papers.map(paper => <PaperCard data={paper} />)}
    </section>
  </CardSection>
</BaseLayout>
