---
import { getCollection } from 'astro:content'

import CardSection from '~components/general/CardSection.astro'
import PostCard from '~components/cards/PostCard.astro'

import BaseLayout from '~layouts/BaseLayout.astro'

const categories = (await getCollection('categories')).toSorted(
  (category1, category2) => category1.data.order - category2.data.order,
)

const posts = (await getCollection('posts'))
  .map(post => ({
    slug: post.id,
    title: post.data.title,
    icon: post.data.icon,
    date: post.data.date,
    categoryId: post.data.category.id,
    tags: post.data.tags,
  }))
  .toSorted((post1, post2) => post2.date.getTime() - post1.date.getTime())
---

<BaseLayout title="Blog">
  <h1 class="mb-12 text-5xl font-bold">Blog</h1>
  {
    categories.map(category => (
      <CardSection title={`${category.data.icon} ${category.data.name}`}>
        <section class="my-8 flex flex-col gap-4">
          {posts
            .filter(post => post.categoryId === category.id)
            .map(post => (
              <PostCard
                slug={post.slug}
                title={post.title}
                icon={post.icon}
                date={post.date}
              />
            ))}
        </section>
      </CardSection>
    ))
  }
</BaseLayout>
