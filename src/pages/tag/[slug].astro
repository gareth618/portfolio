---
import { getCollection } from 'astro:content'

import PostCard from '~components/cards/PostCard.astro'

import BaseLayout from '~layouts/BaseLayout.astro'

import { slugify } from '~utils/slugs'

export async function getStaticPaths() {
  const posts = await getCollection('posts')
  const tags = [...new Set(posts.map(post => post.data.tags).flat())]
  return tags.map(tag => ({
    params: { slug: slugify(tag) },
    props: {
      tag,
      slugs: posts
        .filter(post => post.data.tags.includes(tag))
        .map(post => post.id),
    },
  }))
}

const { tag, slugs } = Astro.props

const posts = (await getCollection('posts'))
  .map(post => ({
    slug: post.id,
    title: post.data.title,
    icon: post.data.icon,
    date: post.data.date,
    tags: post.data.tags,
    abstract: post.data.abstract,
  }))
  .filter(post => slugs.includes(post.slug))
  .toSorted((post1, post2) => post2.date.getTime() - post1.date.getTime())
---

<BaseLayout title={`Tag #${tag.replaceAll(' ', '-')}`}>
  <h1 class="mb-12 text-5xl font-bold">
    Tag
    <span class="wrap-anywhere text-green-300 before:content-['#']"
      >{tag.replaceAll(' ', '-')}</span
    >
  </h1>
  <section class="my-8 flex flex-col gap-4">
    {
      posts.map(post => (
        <PostCard
          slug={post.slug}
          title={post.title}
          icon={post.icon}
          date={post.date}
          abstract={post.abstract}
        />
      ))
    }
  </section>
</BaseLayout>
